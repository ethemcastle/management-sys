# Copy to .env to override defaults. All vars are prefixed CADENCE_.
# CADENCE_DATABASE_URL=sqlite:///./app/cadence.db
# For Postgres (install the 'postgres' extra):
# CADENCE_DATABASE_URL=postgresql+psycopg://cadence:cadence@localhost:5432/cadence
# CADENCE_CORS_ORIGINS=["http://localhost:4200"]
# CADENCE_SEED_ON_STARTUP=true
# CADENCE_AI_LATENCY_SECONDS=1.6
#
# GitHub: set a token to use the LIVE GitHub API (real branches/PRs) instead of
# the mock. Use a fine-grained PAT (Contents: Read, Pull requests: Read on the
# repo) or a GitHub App installation token. Leave unset to keep the offline mock.
# CADENCE_GITHUB_TOKEN=github_pat_xxxxxxxx
#
# AI: set a key to generate REAL summaries / assistant answers (the "Summarize
# thread" button, Ask AI) instead of the deterministic mock. Anything wrong
# (bad key, quota, offline) safely falls back to the mock. Pick ONE provider:
#
# --- Groq (recommended: free, no credit card, works worldwide) ---
#   Get a key at https://console.groq.com/keys , then:
# CADENCE_AI_PROVIDER=openai
# CADENCE_AI_BASE_URL=https://api.groq.com/openai/v1
# CADENCE_AI_MODEL=llama-3.3-70b-versatile
# CADENCE_AI_API_KEY=gsk_...
#
# --- Google Gemini (free tier is region-limited; needs billing in some countries) ---
#   Key at https://aistudio.google.com/apikey , then just:
# CADENCE_AI_API_KEY=AIzaSy...            # provider defaults to "gemini"
#
# --- Local Ollama (no key, fully offline) ---
# CADENCE_AI_PROVIDER=openai
# CADENCE_AI_BASE_URL=http://localhost:11434/v1
# CADENCE_AI_MODEL=llama3.2
# CADENCE_AI_API_KEY=ollama               # any non-empty value activates the live path
#
# Inbox: set a mailbox + app password to import REAL email over IMAP instead of the
# seeded mock inbox. Gmail: enable 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords (16 chars). Works for any IMAP host.
# CADENCE_MAIL_ADDRESS=you@gmail.com
# CADENCE_MAIL_APP_PASSWORD=abcd efgh ijkl mnop
# CADENCE_MAIL_IMAP_HOST=imap.gmail.com    # e.g. outlook.office365.com for Outlook
# CADENCE_MAIL_SYNC_LIMIT=40               # how many recent messages to import
